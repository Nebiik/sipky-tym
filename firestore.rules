rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(userPath())
        && get(userPath()).data.role in ['member', 'admin'];
    }
    function isAdmin() {
      return signedIn() && exists(userPath())
        && get(userPath()).data.role == 'admin';
    }

    // Uživatelé. Nový člověk se vždy založí jako "pending", schválí ho admin.
    match /users/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;

      allow update: if
        // každý může změnit jen své zobrazované jméno
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 40)
        ||
        // admin může měnit roli
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['pending', 'member', 'admin']);

      allow delete: if isAdmin();
    }

    // Události (trénink, zápas, akce).
    match /events/{eventId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'title', 'startsAt', 'location', 'notes', 'createdBy', 'createdAt'])
        && request.resource.data.type in ['training', 'match', 'party', 'other']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.startsAt is timestamp;

      allow update: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.keys().hasOnly(['type', 'title', 'startsAt', 'location', 'notes', 'createdBy', 'createdAt'])
        && request.resource.data.type in ['training', 'match', 'party', 'other']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.startsAt is timestamp;

      allow delete: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);

      // Hlasování Můžu / Nemůžu. Každý hlasuje jen za sebe.
      match /rsvps/{uid} {
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['status', 'note', 'updatedAt'])
          && request.resource.data.status in ['yes', 'no']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200;

        allow delete: if isMember()
          && (request.auth.uid == uid
              || isAdmin()
              || get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid);
      }
    }

    // Umožní jedním dotazem načíst hlasování ke všem událostem.
    match /{path=**}/rsvps/{uid} {
      allow read: if isMember();
    }
  }
}
