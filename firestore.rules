rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(userPath())
        && get(userPath()).data.role in ['member', 'admin'];
    }
    function isAdmin() {
      return signedIn() && exists(userPath())
        && get(userPath()).data.role == 'admin';
    }

    // Uživatelé. Nový člověk se vždy založí jako "pending", schválí ho admin.
    match /users/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'createdAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;

      allow update: if
        // každý může změnit jen své jméno a barvu kolečka
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'color'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 40
          && (!('color' in request.resource.data)
              || request.resource.data.color in ['red', 'orange', 'gold', 'green', 'teal', 'blue', 'purple', 'pink']))
        ||
        // admin může měnit roli
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['pending', 'member', 'admin']);

      allow delete: if isAdmin();
    }

    // Soukromé údaje (e-mail). Čte je jen majitel a správce, ostatní členové ne.
    match /userPrivate/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string;
      allow delete: if isAdmin();
    }

    // Události (trénink, zápas, akce).
    match /events/{eventId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'title', 'startsAt', 'location', 'notes', 'createdBy', 'createdAt'])
        && request.resource.data.type in ['training', 'match', 'party', 'other']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.startsAt is timestamp;

      allow update: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.keys().hasOnly(['type', 'title', 'startsAt', 'location', 'notes', 'createdBy', 'createdAt'])
        && request.resource.data.type in ['training', 'match', 'party', 'other']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.startsAt is timestamp;

      allow delete: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);

      // Hlasování Můžu / Nemůžu. Každý hlasuje jen za sebe.
      match /rsvps/{uid} {
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['status', 'note', 'updatedAt'])
          && request.resource.data.status in ['yes', 'no']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200;

        allow delete: if isMember()
          && (request.auth.uid == uid
              || isAdmin()
              || get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid);
      }
    }

    // Turnaje: číst smí každý člen, zakládat také. Měnit a mazat smí autor nebo správce.
    match /tournaments/{tid} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'game', 'date', 'double', 'players', 'matches', 'results', 'createdBy', 'createdAt'])
        && request.resource.data.game in ['501-do', '501-dido', '301-do', '301-dido', 'kriket']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.date is timestamp
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 16
        && request.resource.data.matches is list
        && request.resource.data.matches.size() <= 240
        && request.resource.data.results is map;

      allow update: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.keys().hasOnly(['name', 'game', 'date', 'double', 'players', 'matches', 'results', 'createdBy', 'createdAt'])
        && request.resource.data.game in ['501-do', '501-dido', '301-do', '301-dido', 'kriket']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.date is timestamp
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 16
        && request.resource.data.matches is list
        && request.resource.data.matches.size() <= 240
        && request.resource.data.results is map;

      allow delete: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // Ligová kola. Kolo založí a zapisovat do něj může každý člen. Soupeře, datum a sestavy mění
    // a kolo maže autor nebo správce. Skóre kola (souhrn) smí přepsat kdokoli, kdo zapisuje.
    match /rounds/{rid} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['opponent', 'date', 'ourPlayers', 'oppPlayers', 'ourWins', 'oppWins', 'played', 'createdBy', 'createdAt'])
        && request.resource.data.opponent is string
        && request.resource.data.opponent.size() <= 60
        && request.resource.data.date is timestamp
        && request.resource.data.ourPlayers is list
        && request.resource.data.ourPlayers.size() <= 16
        && request.resource.data.oppPlayers is list
        && request.resource.data.oppPlayers.size() <= 12;

      allow update: if isMember() && (
        ((isAdmin() || resource.data.createdBy == request.auth.uid)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(['opponent', 'date', 'ourPlayers', 'oppPlayers', 'ourWins', 'oppWins', 'played', 'createdBy', 'createdAt'])
          && request.resource.data.opponent is string
          && request.resource.data.opponent.size() <= 60
          && request.resource.data.date is timestamp
          && request.resource.data.ourPlayers is list
          && request.resource.data.ourPlayers.size() <= 16
          && request.resource.data.oppPlayers is list
          && request.resource.data.oppPlayers.size() <= 12)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ourWins', 'oppWins', 'played'])
          && request.resource.data.ourWins is int
          && request.resource.data.oppWins is int
          && request.resource.data.played is int)
      );

      allow delete: if isMember()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);

      // Zápasy kola (1 až 18). Zapisovat smí každý člen.
      match /matches/{mid} {
        allow read: if isMember();

        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['slot', 'kind', 'ourId', 'ourName', 'oppId', 'oppName', 'legsToWin', 'legs', 'status', 'result', 'createdBy', 'updatedAt'])
          && request.resource.data.slot is int
          && request.resource.data.slot >= 1
          && request.resource.data.slot <= 18
          && request.resource.data.kind in ['single', 'team501', 'cricket']
          && request.resource.data.status in ['playing', 'done']
          && request.resource.data.legs is list
          && request.resource.data.legs.size() <= 7
          && request.resource.data.result is map;

        allow delete: if isMember();
      }
    }

    // Umožní jedním dotazem načíst hlasování ke všem událostem.
    match /{path=**}/rsvps/{uid} {
      allow read: if isMember();
    }
  }
}
